generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum RecipeCategory {
  SWEET
  SAVORY
}

enum PhotoType {
  COVER
  USER
}

// ─────────────────────────────────────────
// Modelos
// ─────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  sessions Session[]
}

// Uma sessão = um login em um dispositivo. Os refresh tokens dela formam uma
// "família": a cada renovação o token usado é marcado (usedAt) e um novo é
// emitido. Reapresentar um token já usado indica roubo e revoga a sessão.
model Session {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime  // tempo de vida absoluto; nenhuma renovação passa disso
  revokedAt  DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique // SHA-256 do token; o valor bruto nunca é persistido
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Recipe {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  reference   String?
  category    RecipeCategory
  isPublic    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  notes               RecipeNote[]
  ingredientGroups    IngredientGroup[]
  preparationMethods  PreparationMethod[]
  photos              RecipePhoto[]
  cookHistory CookHistory[]
  tags        RecipeTag[]

  @@index([deletedAt])
}

model RecipeNote {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model IngredientGroup {
  id    Int     @id @default(autoincrement())
  title String?
  order Int

  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  ingredients Ingredient[]

  @@index([recipeId])
  @@unique([recipeId, order])
}

model Ingredient {
  id       Int    @id @default(autoincrement())
  name   String
  amount String
  order  Int

  ingredientGroupId Int
  ingredientGroup   IngredientGroup @relation(fields: [ingredientGroupId], references: [id], onDelete: Cascade)

  @@index([ingredientGroupId])
}

model PreparationMethod {
  id    Int     @id @default(autoincrement())
  title String?
  order Int

  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  steps Step[]

  @@index([recipeId])
  @@unique([recipeId, order])
}

model Step {
  id          Int    @id @default(autoincrement())
  description String
  order       Int

  preparationMethodId Int
  preparationMethod   PreparationMethod @relation(fields: [preparationMethodId], references: [id], onDelete: Cascade)

  @@index([preparationMethodId])
  @@unique([preparationMethodId, order])
}

model RecipePhoto {
  id        Int       @id @default(autoincrement())
  url       String
  type      PhotoType
  positionY Int       @default(50)

  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model CookHistory {
  id     Int      @id @default(autoincrement())
  date   DateTime @default(now())
  notes  String?

  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model Tag {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  color String

  recipes RecipeTag[]
}

model RecipeTag {
  recipeId Int
  tagId    Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}
