NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
FRONTEND_URL="http://localhost:5173"
PORT=3000

ALLOW_NEW_USERS=false

JWT_SECRET=""
JWT_EXPIRES_IN="15m"

# Refresh token (opaco, em cookie HttpOnly, rotacionado a cada uso)
# Expira após N dias sem uso; a sessão nunca passa de SESSION_MAX_AGE_DAYS
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_AGE_DAYS=90
# "strict" se front e API estão no mesmo site (ex.: app.dominio.com + api.dominio.com);
# "none" apenas se estiverem em domínios diferentes
REFRESH_COOKIE_SAMESITE="strict"

AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
