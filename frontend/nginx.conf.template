# Template processado pelo entrypoint da imagem oficial do nginx (envsubst):
# só ${BACKEND_URL} é substituído; as variáveis do nginx ficam intactas.

# Robôs que montam a prévia de links (WhatsApp, Telegram, iMessage...).
# Eles não executam JavaScript, então recebem um HTML com as meta tags da
# receita gerado pelo backend. Pessoas continuam recebendo o SPA.
map $http_user_agent $is_preview_bot {
  default 0;
  "~*(?:facebookexternalhit|facebot|whatsapp|telegrambot|twitterbot|slackbot|discordbot|linkedinbot|pinterest|skypeuripreview|redditbot|applebot|googlebot|bingbot|embedly|vkshare|mastodon)" 1;
}

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Compressão
  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types
    text/plain
    text/css
    text/javascript
    application/javascript
    application/json
    application/xml
    image/svg+xml;

  # Assets com hash no nome → cache longo e imutável
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Página pública da receita: robôs de prévia recebem as meta tags.
  # Captura nomeada porque $1 é sobrescrito pelas regex do map e do rewrite.
  location ~ "^/detalhes-da-receita/(?<recipe_id>\d{1,9})/?$" {
    if ($is_preview_bot) {
      rewrite ^ /__recipe-preview/$recipe_id last;
    }
    add_header Vary User-Agent;
    try_files /index.html =404;
  }

  # Só alcançável pelo rewrite acima (internal), nunca por URL direta
  location ~ "^/__recipe-preview/(?<preview_id>\d{1,9})$" {
    internal;

    # DNS do Docker resolvido a cada request: o nginx sobe mesmo se o
    # backend estiver fora do ar
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $backend_url "${BACKEND_URL}";
    proxy_pass $backend_url/api/public/recipes/$preview_id/preview;

    # Repassa só o necessário: nada de cookies, credenciais ou corpo
    proxy_method GET;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    # IP real do cliente (adicionado pelo nginx do CapRover) p/ o rate limit
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_hide_header Set-Cookie;

    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;

    # Receita privada/inexistente ou backend fora do ar → prévia padrão do site
    proxy_intercept_errors on;
    error_page 400 404 429 500 502 503 504 = /index.html;

    add_header Vary User-Agent;
  }

  # SPA fallback: qualquer rota cai no index.html
  location / {
    try_files $uri $uri/ /index.html;
  }
}
